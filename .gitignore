# Sensitive
.env
.env.*
*.key
*.pem
**/credentials.json
**/secrets.json

# Cache and ephemeral data
__pycache__/
*.pyc
*.pyo
.cache/
data/cache/
*.parquet.cache

# Python venv
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Obsidian vault config (themes, workspace layout, plugin state)
.obsidian/

# OS
.DS_Store
Thumbs.db

# Claude Code per-machine state
.claude/state/
.claude/cache/
.claude/logs/

# Local-only files (use this suffix for anything you don't want committed)
*.local.md
*.local.json
*.local.py

# Raw absorbed sources — never committed. Third-party material (investor letters,
# paid transcripts, report PDFs) carries copyright, and the extracted text is bulky.
# The DISTILLED library entry is the committed record; durability of the raw source
# comes from the off-machine mirror (scripts/mirror-sources.py), not from git.
# Also add both of these to Obsidian: Settings > Files & Links > Excluded files —
# gitignore hides them from git, not from the quick switcher, search, or graph.
library/_inbox/
library/sources/
